# Copy to .env.local and adjust.

# "true"  -> use the built-in MOCK API (no backend needed). Mock results are NOT AI-generated.
# "false" -> call the real backend at /api (proxied to http://localhost:8000 by vite.config.js)
VITE_USE_MOCK=true

# Sample .glb returned by the mock API. Replace with /models/sample.glb if you
# drop your own file into public/models/.
VITE_MOCK_ASSET_URL=https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/main/Models/Duck/glTF-Binary/Duck.glb
